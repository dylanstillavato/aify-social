# Backend origin — only needed in production, where the frontend (Vercel) and
# backend (Render/Railway/etc.) live on different domains. Leave unset locally;
# vite.config.js's dev proxy handles /api/* against localhost:3011 instead.
VITE_API_URL=https://tu-backend.onrender.com

# MCP de Aify con OAuth (claude.ai, Claude Desktop, ChatGPT; docs/mcp.md):
# URL pública de este servidor, sin barra final. El conector se añade con
# <AIFY_BACKEND_URL>/mcp. Sin ella se usa el origen de INSTAGRAM_REDIRECT_URI.
# La pantalla «Permitir» está en el primer origen de GOOGLE_FRONTEND_URL.
AIFY_BACKEND_URL=http://localhost:3011

# Tu IA — Aify no tiene claves de IA propias: cada organización guarda la suya
# (Configuración → Tu IA) y server.js la cifra con este secreto. Cualquier
# texto largo y aleatorio vale; si cambia, las claves guardadas ya no se leen.
AI_KEYS_SECRET=un_texto_largo_y_aleatorio

# Supabase — VITE_SUPABASE_ANON_KEY is the public anon key, safe for the client
VITE_SUPABASE_URL=tu_project_url
VITE_SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui

# YouTube Data API — used client-side (trends), restrict by HTTP referrer in Google Cloud Console
VITE_YOUTUBE_API_KEY=tu_youtube_api_key_aqui

# Google Business Profile OAuth (server-side)
GOOGLE_CLIENT_ID=tu_google_client_id_aqui
GOOGLE_CLIENT_SECRET=tu_google_client_secret_aqui
# In production, GOOGLE_REDIRECT_URI must point at the deployed backend and
# GOOGLE_FRONTEND_URL at the deployed frontend (also used as the CORS origin —
# comma-separate multiple origins if needed).
GOOGLE_REDIRECT_URI=http://localhost:3011/api/google/callback
GOOGLE_FRONTEND_URL=http://localhost:5174

# Instagram (métricas reales, server-side). Flujo "Instagram API with Instagram
# Login" — ver docs/instagram-setup.md. INSTAGRAM_APP_ID/SECRET son los del
# producto Instagram de la app de Meta (no el ID de la app de Facebook).
# INSTAGRAM_REDIRECT_URI debe coincidir exactamente con la registrada en Meta.
# GOOGLE_FRONTEND_URL (arriba) se reutiliza para volver al frontend.
INSTAGRAM_APP_ID=tu_instagram_app_id_aqui
INSTAGRAM_APP_SECRET=tu_instagram_app_secret_aqui
INSTAGRAM_REDIRECT_URI=http://localhost:3011/api/instagram/callback
INSTAGRAM_GRAPH_VERSION=v23.0

# TikTok (conectar y publicar, server-side) — ver docs/tiktok-setup.md.
# TIKTOK_REDIRECT_URI debe coincidir exactamente con la registrada en TikTok.
# TIKTOK_VERIFICACION_*: el archivo que da TikTok para verificar el prefijo
# de URL (se sirve en /api/tiktok/medios/<archivo>). TIKTOK_AUDITADA=1 solo
# cuando TikTok apruebe la auditoría de Direct Post (hasta entonces, privado).
TIKTOK_CLIENT_KEY=tu_tiktok_client_key_aqui
TIKTOK_CLIENT_SECRET=tu_tiktok_client_secret_aqui
TIKTOK_REDIRECT_URI=http://localhost:3011/api/tiktok/callback
TIKTOK_VERIFICACION_ARCHIVO=
TIKTOK_VERIFICACION_CONTENIDO=
TIKTOK_AUDITADA=

# Supabase service role key — server-side only, bypasses RLS. Used for the
# rows the acting member's token can't touch (tokens de redes, claves de IA,
# organizaciones). Get it
# from Supabase → Settings → API Keys → Secret keys (NOT the anon key above).
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key_aqui

# Places API (New), para traer las reseñas de Google Maps de un cliente en
# "Voz del cliente". Sin ella la app solo ofrece pegar el texto de las reseñas.
GOOGLE_PLACES_API_KEY=tu_google_places_api_key_aqui
